<glsa id="202608-32">
    <title>Tor: Multiple Vulnerabilities</title>
    <synopsis>Multiple vulnerabilities have been found in Tor, the worst of which could allow remote code execution.</synopsis>
    <product type="ebuild">tor</product>
    <announced>2026-08-29</announced>
    <revised count="1">2026-08-29</revised>
    <bug>965987</bug>
