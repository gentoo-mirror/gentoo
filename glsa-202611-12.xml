<glsa id="202611-12">
    <title>Ruby: Multiple Vulnerabilities</title>
    <synopsis>Multiple vulnerabilities have been found in Ruby.</synopsis>
    <product type="ebuild">resolv,ruby</product>
    <announced>2026-11-19</announced>
    <revised count="1">2026-11-19</revised>
    <bug>983391</bug>
    <bug>984771</bug>
    <bug>986782</bug>
    <access>remote</access>
    <affected>
        <package name="dev-lang/ruby" auto="yes" arch="*">
            <unaffected range="ge" slot="3.3">3.3.13</unaffected>
            <unaffected range="ge" slot="3.4">3.4.12</unaffected>
            <unaffected range="ge" slot="4.0">4.0.9</unaffected>
            <vulnerable range="lt" slot="3.3">3.3.13</vulnerable>
            <vulnerable range="lt" slot="3.3">3.3.13</vulnerable>
            <vulnerable range="lt" slot="4.0">4.0.9</vulnerable>
        </package>
        <package name="dev-ruby/resolv" auto="yes" arch="*">
            <unaffected range="ge">0.7.2</unaffected>
            <vulnerable range="lt">0.7.2</vulnerable>
        </package>
    </affected>
    <background>
        <p>Ruby is an interpreted scripting language for quick and easy object-oriented programming.</p>
    </background>
    <description>
        <p>Multiple vulnerabilities have been discovered in Ruby. Please review the CVE identifiers referenced below for details.</p>
    </description>
    <impact type="high">
        <p>Please review the referenced CVE identifiers for details.</p>
    </impact>
    <workaround>
        <p>There is no known workaround at this time.</p>
    </workaround>
    <resolution>
        <p>All Ruby 3.3 users should upgrade to the latest version:</p>
        
        <code>
          # emerge --sync
          # emerge --ask --oneshot --verbose ">=dev-lang/ruby-3.3.14:3.3"
        </code>
        
        <p>All Ruby 3.4 users should upgrade to the latest version:</p>
        
        <code>
          # emerge --sync
          # emerge --ask --oneshot --verbose ">=dev-lang/ruby-3.4.13:3.4"
        </code>
        
        <p>All Ruby 4.0 users should upgrade to the latest version:</p>
        
        <code>
          # emerge --sync
          # emerge --ask --oneshot --verbose ">=dev-lang/ruby-4.0.10:4.0"
        </code>
        
        <p>All resolv gem users should upgrade to the latest version:</p>
        
        <code>
          # emerge --sync
          # emerge --ask --oneshot --verbose ">=dev-ruby/resolv-0.7.2"
        </code>
    </resolution>
