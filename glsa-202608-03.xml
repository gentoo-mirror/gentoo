        <uri link="https://nvd.nist.gov/vuln/detail/CVE-2026-43618">CVE-2026-43618</uri>
        <uri link="https://nvd.nist.gov/vuln/detail/CVE-2026-43619">CVE-2026-43619</uri>
        <uri link="https://nvd.nist.gov/vuln/detail/CVE-2026-43620">CVE-2026-43620</uri>
        <uri link="https://nvd.nist.gov/vuln/detail/CVE-2026-45232">CVE-2026-45232</uri>
    </references>
