<glsa id="202608-29">
    <title>Chromium, Google Chrome, Microsoft Edge, Opera: Multiple Vulnerabilities</title>
    <synopsis>Multiple vulnerabilities have been found in Chromium, Google Chrome, Microsoft Edge, and Opera.</synopsis>
    <product type="ebuild">chromium,google-chrome,microsoft-edge,opera</product>
    <announced>2026-08-27</announced>
    <revised count="1">2026-08-27</revised>
    <bug>939217</bug>
    <bug>939451</bug>
    <bug>939801</bug>
