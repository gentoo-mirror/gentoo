        <uri link="https://nvd.nist.gov/vuln/detail/CVE-2026-4893">CVE-2026-4893</uri>
        <uri link="https://nvd.nist.gov/vuln/detail/CVE-2026-5172">CVE-2026-5172</uri>
    </references>
