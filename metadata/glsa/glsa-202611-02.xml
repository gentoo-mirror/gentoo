        <uri link="https://nvd.nist.gov/vuln/detail/CVE-2026-113408">CVE-2026-113408</uri>
        <uri link="https://nvd.nist.gov/vuln/detail/CVE-2026-114466">CVE-2026-114466</uri>
        <uri link="https://nvd.nist.gov/vuln/detail/CVE-2026-114467">CVE-2026-114467</uri>
        <uri link="https://nvd.nist.gov/vuln/detail/CVE-2026-114469">CVE-2026-114469</uri>
    </references>
