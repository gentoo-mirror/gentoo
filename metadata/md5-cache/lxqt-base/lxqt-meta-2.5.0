DEFINED_PHASES=-
DESCRIPTION=Meta ebuild for LXQt, the Lightweight Desktop Environment
EAPI=8
HOMEPAGE=https://lxqt-project.org/
IUSE=+about admin +archiver clip +desktop-portal +display-manager +filemanager +icons +lximage nls +policykit powermanagement +processviewer +screenshot +sddm ssh-askpass +sudo +terminal +trash wayland +window-manager
KEYWORDS=~amd64 ~arm64 ~ppc64 ~riscv ~x86
LICENSE=metapackage
RDEPEND==lxqt-base/lxqt-config-2.5* =lxqt-base/lxqt-globalkeys-2.5* =lxqt-base/lxqt-menu-data-2.5* =lxqt-base/lxqt-notificationd-2.5* =lxqt-base/lxqt-panel-2.5* =lxqt-base/lxqt-qtplugin-2.5* =lxqt-base/lxqt-runner-2.5* =lxqt-base/lxqt-session-2.5* virtual/ttf-fonts x11-terms/xterm =x11-themes/lxqt-themes-2.5* about? ( =lxqt-base/lxqt-about-2.5* ) admin? ( =lxqt-base/lxqt-admin-2.5* ) archiver? ( >=app-arch/lxqt-archiver-1.5 ) clip? ( =gui-apps/lxqt-clip-2.5* ) desktop-portal? ( >=gui-libs/xdg-desktop-portal-lxqt-1.5 ) display-manager? ( sddm? ( gui-apps/sddm ) !sddm? ( x11-misc/lightdm ) ) filemanager? ( =x11-misc/pcmanfm-qt-2.5* ) icons? ( kde-frameworks/breeze-icons:6 ) lximage? ( =media-gfx/lximage-qt-2.5* ) nls? ( dev-qt/qttranslations:6 ) policykit? ( =lxqt-base/lxqt-policykit-2.5* ) powermanagement? ( =lxqt-base/lxqt-powermanagement-2.5* ) processviewer? ( >=x11-misc/qps-2.14 ) screenshot? ( >=x11-misc/screengrab-3.3 ) sddm? ( gui-apps/sddm ) ssh-askpass? ( =lxqt-base/lxqt-openssh-askpass-2.5* ) sudo? ( =lxqt-base/lxqt-sudo-2.5* ) terminal? ( =x11-terms/qterminal-2.5* ) trash? ( gnome-base/gvfs ) wayland? ( lxqt-base/lxqt-wayland-session ) window-manager? ( kde-plasma/systemsettings:6 wayland? ( kde-plasma/kwin:6 ) !wayland? ( kde-plasma/kwin-x11:6 ) )
REQUIRED_USE=trash? ( filemanager )
SLOT=0
_md5_=44f1beab66e025366c3ce96bfec0337b
