        <uri link="https://nvd.nist.gov/vuln/detail/CVE-2025-47905">CVE-2025-47905</uri>
        <uri link="https://nvd.nist.gov/vuln/detail/CVE-2026-50052">CVE-2026-50052</uri>
    </references>
