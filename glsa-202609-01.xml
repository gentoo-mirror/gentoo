<glsa id="202609-01">
    <title>Chromium, Google Chrome, Microsoft Edge, Opera, Vivaldi: Multiple Vulnerabilities</title>
    <synopsis>Multiple vulnerabilities have been found in Chromium, Google Chrome, Microsoft Edge, Opera, and Vivaldi.</synopsis>
    <product type="ebuild">chromium,google-chrome,microsoft-edge,opera,vivaldi</product>
    <announced>2026-09-01</announced>
    <revised count="1">2026-09-01</revised>
